 "methods": [
  {
   "id": "sampled_tree",
   "label": "Sampled decoding",
   "what": "How a request with a temperature is checked against the draft. det walks the same tree a greedy request uses and is the fastest; the answers match the model sampled alone.",
   "type": "enum",
   "options": [
    {
     "value": "det",
     "label": "det (tree",
     "recommended)": null
    },
