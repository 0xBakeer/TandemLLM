# the image needs pyproject.toml, VERSION, the license files, docs/proxy.md, proxy/, server/,
# chatd/ and packages/ (the wheel's declared packages) and dashboard/dist/ only
*
!pyproject.toml
!VERSION
!LICENSE
!COMMERCIAL-LICENSE.md
!NOTICE
!docs/proxy.md
!proxy/
!server/
!chatd/
!packages/
!dashboard/dist/
**/__pycache__
