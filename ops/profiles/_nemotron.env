# Shared by every nemotron-<variant> profile (sourced from it after QSE_NH_MODEL, QSE_NH_VARIANT, the weights'
# repo and size and the memory need are set): NVIDIA's NemotronH hybrid (engine/models/nemotron_h) from its BF16
# checkpoint. Nothing else is fetched: no drafter or base snapshot (QSE_ASSETS empty). Text only unless the profile
# says VISION=on (Super VL: the checkpoint's RADIO tower, ENG-365; Bolt's GGUF has no tower beside it).
# QSE_ENGINE_FLAGS replaces the 27B's model and drafter flags in ops/start.sh; the rest of serve.env
# (port, ledger, conductor, limits) is shared.
QSE_WEIGHTS=nemotron-${QSE_NH_VARIANT}
# the weights folder: QSE_NH_DIR where a profile names it (Super VL: nemotron-super-vl-<x> serves
# ~/models/nemotron-3.5-super-vl-120b-a12b-<x>), else the model and the variant's weights part
QSE_WEIGHTS_DIR=${QSE_NH_DIR:-${HOME}/models/${QSE_NH_MODEL}-${QSE_NH_VARIANT#*-}}
QSE_WEIGHTS_FILES=
QSE_ASSETS=
unset QWEN38_EXL3 QWEN38_DRAFT_EXL3 QWEN38_DRAFT_HEAD_EXL3
# the lookup cut by StairCut drafts; the checkpoint's MTP head joins it with --draft-head mtp (QSE_NH_HEAD)
QSE_ENGINE_FLAGS="--model ${QSE_WEIGHTS_DIR} --drafter mtp ${QSE_NH_HEAD:+--draft-head $QSE_NH_HEAD --depth 3}"
VISION=off
QSE_PARALLEL=3
QSE_KV_POOL=off
# the checkpoint's generation_config.json: temperature 1.0, top_p 0.95
TEMPERATURE=1.0
TOP_P=0.95
# the lookup's suffix store of this tokenizer (the other models' stores hold other token ids)
QWEN38_SUFFIX_STORE=${HOME}/.qwen38-spark-engine/suffix-nemotron
QSE_PAGE_CACHE_DROP=${QSE_WEIGHTS_DIR}
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-nemotron-${QSE_NH_VARIANT}
SESSION_SPILL=on
