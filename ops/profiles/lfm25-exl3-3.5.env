# Weight profile lfm25-exl3-3.5: LFM2.5-24B-A2B in our EXL3 pack at 3.5 bpw (exllamav3 1.6.0, mul1 codebook,
# head 6 bits; ~11.0 GB from the parameter count until the pack is measured), converted from the BF16
# checkpoint at revision 1769516a. The pack is not on the Hub yet. Switch with ops/use-profile.sh lfm25-exl3-3.5.
QSE_LFM_VARIANT=exl3-3.5
QSE_WEIGHTS_HF=0xBakeer/TandemLLM-LFM2.5-24B-A2B-EXL3-3.5
QSE_WEIGHTS_GB=11.0
# MemAvailable (GiB) a start needs: the weights, the engine and its graphs, the allocator, the prefill
# workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=35
# SRV-335: the engine's limits. Ceiling: the weights (10.24) + the runtime (an estimate of 4 until
# measured) + the KV at 131,072 tokens (2.5); peak: the ceiling + the prefill workspace (an estimate of 3)
MEM_CEILING_GIB=17
MEM_PEAK_GIB=20
. "${REPO}/ops/profiles/_lfm25.env"
