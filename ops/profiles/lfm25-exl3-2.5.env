# Weight profile lfm25-exl3-2.5: LFM2.5-24B-A2B in our EXL3 pack at 2.5 bpw (exllamav3 1.6.0, mul1 codebook,
# head 6 bits; 8.2 GB measured), converted from the BF16
# checkpoint at revision 1769516a. The pack is in a private Hugging Face repository until it is published. Switch with ops/use-profile.sh lfm25-exl3-2.5.
QSE_LFM_VARIANT=exl3-2.5
QSE_WEIGHTS_HF=0xBakeer/TandemLLM-LFM2.5-24B-A2B-EXL3-2.5
QSE_WEIGHTS_REVISION=62ee041060eadb5081c3306c7629c7919b187b11
QSE_WEIGHTS_GB=8.2
# MemAvailable (GiB) a start needs: the weights, the engine and its graphs, the allocator, the prefill
# workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=33
# SRV-335: the engine's limits. Ceiling: the weights (7.64 at load, measured) + the runtime (an estimate of 4 until
# measured) + the KV at 131,072 tokens (2.5); peak: the ceiling + the prefill workspace (an estimate of 3)
MEM_CEILING_GIB=15
MEM_PEAK_GIB=18
. "${REPO}/ops/profiles/_lfm25.env"
