# Shared by every flashnext-<bpw> profile (sourced from it after QSE_FN_BPW, QSE_WEIGHTS_REVISION, the
# table policy and the memory need are set): Qwen3.8-Flash-Next in turboderp's EXL3 pack at that size,
# one branch of one HF repo (OPS-97). The pack carries its own draft layer (the MTP drafter) and its
# n-gram table, so nothing else is fetched and no 27B drafter, draft head or base snapshot is needed
# (QSE_ASSETS empty). QSE_ENGINE_FLAGS replaces the 27B's model and drafter flags in ops/start.sh; the
# rest of serve.env (port, ledger, conductor, limits, caches) is shared.
QSE_WEIGHTS=flashnext-${QSE_FN_BPW}
QSE_WEIGHTS_HF=turboderp/Qwen3.8-Flash-Next-exl3
QSE_WEIGHTS_DIR=${HOME}/flashnext-packs/${QSE_FN_BPW}
QSE_WEIGHTS_FILES=
# what weights_ok checks beside the index's shards: the table is not in the index, nor 4.05's vision tower
QSE_WEIGHTS_ALSO="ngram_embedding.safetensors ${QSE_FN_VISION_FILE:-}"
QSE_ASSETS=
unset QWEN38_EXL3 QWEN38_DRAFT_EXL3 QWEN38_DRAFT_HEAD_EXL3
QWEN38_SAMPLE_NUCLEUS=1
QSE_ENGINE_FLAGS="--model ${QSE_WEIGHTS_DIR} --drafter mtp"
# VIS-97: the pack's own vision tower on the EXL3 kernels (engine/models/flashnext/vision.py), 0.29 GB in 3.05;
# images take three-axis rotary positions in the prompt (tools/fn_vision_check.py against transformers). A
# pack without the tower starts with vision off and says so
VISION=on
# ENG-229: the lookup (the request's text, CORPUS and the suffix store) in the MTP round's cut; the A/B
# of 2026-10-12 (3.05, one greedy request a class): edit 106 -> 132 tok/s, copy 102 -> 133, prose 49 -> 51,
# chat 62 -> 64, code 85 -> 83, every text the same
QWEN38_FN_LOOKUP=1
# ENG-239: warm keeps the table in the page cache (the page-cache drop after the start leaves it alone,
# and every floor counts it, SRV-335); cold reads it past the page cache through a row cache
QWEN38_FN_TABLE=${QSE_FN_TABLE}
QWEN38_FN_TABLE_CACHE_GB=2
QSE_PAGE_CACHE_DROP=${QSE_WEIGHTS_DIR}
QSE_PAGE_CACHE_KEEP=$([ "${QSE_FN_TABLE}" = "warm" ] && echo ngram_embedding.safetensors)
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-flashnext-${QSE_FN_BPW}
# ENG-241: three sequence slots over one engine, every window on the shared KV pool (2026-10-12, 3.05,
# fresh servers, greedy, raw): three requests arriving together took 27.18 s against 27.03 s one after
# the other (the same total tok/s), with first tokens at 2.2-6.1 s instead of up to ~20 s; each answer
# equal to its single-stream answer; one request alone 45.78 tok/s against 45.79 at --parallel 1; at
# 262,144 tokens with two 65,536-token side slots a 260,800-token prompt kept MemAvailable at 31.6 GiB
# or above (the floor 15). Limits, all serve.env's unless set here: side window QSE_SIDE_MAX_LEN 65,536,
# admission floor QSE_PARALLEL_FLOOR_GB 15, joint verify up to 32 rows, turn quantum 50 ms, batch
# timeout 2 ms, pool hard floor QSE_KV_HARD_FLOOR_GB 10, margin 256 rows; a side slot took 0.22 GiB
# allocated (0.40 GiB of MemAvailable) at load.
QSE_PARALLEL=3
QSE_KV_POOL=on
