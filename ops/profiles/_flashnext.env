# Shared by every flashnext-<bpw> profile (sourced from it after QSE_FN_BPW, QSE_WEIGHTS_REVISION, the
# table policy and the memory need are set): Qwen3.8-Flash-Next in turboderp's EXL3 pack at that size,
# one branch of one HF repo (OPS-97). The pack carries its own draft layer (the MTP drafter) and its
# n-gram table, so nothing else is fetched and no 27B drafter, draft head or base snapshot is needed
# (QSE_ASSETS empty). QSE_ENGINE_FLAGS replaces the 27B's model and drafter flags in ops/start.sh; the
# rest of serve.env (port, ledger, conductor, limits, caches) is shared.
QSE_WEIGHTS=flashnext-${QSE_FN_BPW}
QSE_WEIGHTS_HF=turboderp/Qwen3.8-Flash-Next-exl3
QSE_WEIGHTS_DIR=${HOME}/flashnext-packs/${QSE_FN_BPW}
QSE_WEIGHTS_FILES=
# what weights_ok checks beside the index's shards: the table is not in the index, nor 4.05's vision tower
QSE_WEIGHTS_ALSO="ngram_embedding.safetensors ${QSE_FN_VISION_FILE:-}"
QSE_ASSETS=
unset QWEN38_EXL3 QWEN38_DRAFT_EXL3 QWEN38_DRAFT_HEAD_EXL3
QWEN38_SAMPLE_NUCLEUS=1
QSE_ENGINE_FLAGS="--model ${QSE_WEIGHTS_DIR} --drafter mtp"
# VIS-97: the pack's own vision tower on the EXL3 kernels (engine/models/flashnext/vision.py), 0.29 GB in 3.05;
# images take three-axis rotary positions in the prompt (tools/fn_vision_check.py against transformers). A
# pack without the tower starts with vision off and says so
VISION=on
# ENG-229: the lookup (the request's text, CORPUS and the suffix store) in the MTP round's cut; the A/B
# of 2026-10-12 (3.05, one greedy request a class): edit 106 -> 132 tok/s, copy 102 -> 133, prose 49 -> 51,
# chat 62 -> 64, code 85 -> 83, every text the same
QWEN38_FN_LOOKUP=1
# SPD-249: the joint pass's switches, each row's arithmetic unchanged. A/Bs on fresh servers, 8 prose requests of 512
# tokens at once on /v1/completions, fixed prompts and seeds, the drafters' state frozen, every token the same and the
# joint pass equal to each lane's lone verify bit for bit (2026-10-30): 110.4 and 111.8 tok/s with all of them off,
# 113.4 with the first three; in a second A/B 112.7 and 113.9 with the first three, 120.4 and 121.1 with all of them
QWEN38_FN_MIX_FUSED=1
QWEN38_FN_GDN_PRE_MULTI=1
QWEN38_FN_GDN_DEFER=8
QWEN38_FN_MOE_GR=6
QWEN38_FN_ATTN_MULTI=1
QWEN38_FN_PLE_MULTI=1
QWEN38_FN_POOL_MULTI=1
# SPD-249: a dense joint pass from CUDA graphs keyed by lanes, padded rows and the lanes' KV strides, captured on the
# round runner while no request waits (the same A/B, two servers each, every token the same): 122.6 and 122.3 tok/s
# eager, 125.9 and 126.7 from the graphs
QWEN38_FN_JOINT_GRAPH=1
# SPD-249: /health's full body built at most once a second (the same A/B under a /health poll every 0.25 s, two
# servers each, every token the same: 125.2 and 125.8 tok/s with every call building it, 131.5 and 131.3 with this;
# `/health` `health_cost` has a build's ms by part)
QSE_HEALTH_TTL_MS=1000
# SPD-249: the grouped MoE kernels with their rows streamed beside the tiles, and their groups from one block's
# scans (the same A/B, two servers each, every token the same): 130.9 and 131.9 tok/s without, 134.7 and 133.5 with
QWEN38_FN_MOE_AS=1
QWEN38_FN_MOE_GPAR=1
# SPD-249: a seeded sampled request's MTP drafts are coupled (each the draft head's pick under the
# target's own keyed noise, so every emitted token is still the target's draw; greedy and unseeded requests draft as
# before), from a 64k hot head in packed chains of several lanes and its first 32k rows for one lane, with the depth-1
# sibling and the coupled cut calibration fitted on held-out prompts. A/Bs on fresh servers on /v1/completions,
# prose at T 1.0, top-k 20, top-p 0.95, 512 tokens, fixed prompts and seeds, every token the same, medians of 3
# rounds: 8 requests at once 133.7 -> 141.4 tok/s, one request 54.9 -> 59.0, one 2k-token prompt 46.5 -> 48.5
QWEN38_FN_MTP_COUPLED=1
QWEN38_FN_MTP_COUPLED_HOT=65536
QWEN38_FN_MTP_COUPLED_HOT_LONE=32768
QWEN38_FN_MTP_COUPLED_SIB=1
QWEN38_FN_MTP_COUPLED_CAL=1
# SPD-249: a learned corrector re-scores the coupled pick over the draft head's top 8 (the request must sample at
# T 1.0, top-k 20, top-p 0.95; other rows keep the plain coupled pick; every emitted token is still the target's
# draw), with its own cut calibration. File ops/correctors/qwen3.8-flash-next/flashnext-3.05.corrector.safetensors,
# not in the repository: without it the coupled drafts stay plain, with one log line (the same A/B, 4 pairs of
# servers, every token the same: one request +3.3 to +4.9 %, 8 at once +1.3 to +2.0 %)
QWEN38_FN_MTP_CORRECTOR=1
# SPD-249: the round runner's host work no round waits for (token pushes, the report line, /health rebuilds, live
# ticks) runs in the joint pass's GPU wait; on rounds other lanes share, an MTP lane skips the lookup after a round it
# gave the walk nothing (1, 2, 4 .. 16 rounds; a lone round always looks); the collector's survivors are frozen after
# the load, young generations collected in the GPU wait, a full collection in idle gaps or every 200 rounds (the
# same A/B, every token the same: 8 at once 144.7 -> 148.2 tok/s, a round 106.6 -> 103.0 ms; one request flat; the
# first tokens of a burst of 8 2k-token prompts unchanged)
QSE_RUNNER_BUSY_WORK=1
QWEN38_FN_LOOK_BACKOFF=16
QSE_RUNNER_GC=1
QSE_RUNNER_GC_FULL_ROUNDS=200
# SPD-249: the prompts of a prefill burst in one forward (engine/models/flashnext/joint_prefill.py): each layer's
# experts once for every prompt's rows, the rest a prompt at a time, each prompt's logits, KV and state its own
# prefill's bits. More tokens a second in total, and every first token of the burst waits for the one forward, so long
# prompts in a burst get theirs later (the same A/B, every token the same: 8 at once 148.2 -> 155.5 tok/s, the ramp to
# 8 decoding 3.3 -> 2.1 s; one burst of 8 prompts of 1,630 tokens: first tokens at 1.6 to 12.7 s, median 7.1, against
# 11.2 to 12.0 s, median 11.5)
QWEN38_FN_JOINT_PREFILL=1
# SPD-257: the engine's CUDA allocator grows and shrinks its segments in pages (ops/start.sh hands it to the engine's
# command only, as PYTORCH_CUDA_ALLOC_CONF; an operator's own PYTORCH_CUDA_ALLOC_CONF wins), so `empty` gives back the
# free pages of a segment that still holds a live block: on 3.05 the default pool kept 0.36 to 0.62 GiB free through
# two 8-chat bursts and a 106k prefill, against 2.27 GiB after such a prefill without it (2026-10-31, seeded texts
# the same). Flash-Next only until the other families pass the same checks (their graphs capture pools
# differently). Unsupported (the load line says how many segments are expandable): max_split_size_mb:512
QSE_ENGINE_ALLOC_CONF=${QSE_ENGINE_ALLOC_CONF-expandable_segments:True}
# ENG-239: warm keeps the table in the page cache (the page-cache drop after the start leaves it alone,
# and every floor counts it, SRV-335); cold reads it past the page cache through a row cache
QWEN38_FN_TABLE=${QSE_FN_TABLE}
QWEN38_FN_TABLE_CACHE_GB=2
QSE_PAGE_CACHE_DROP=${QSE_WEIGHTS_DIR}
# a cold table's test fails: `|| true` keeps it from failing a caller under set -e (bin/tandem, OPS-159)
QSE_PAGE_CACHE_KEEP=$([ "${QSE_FN_TABLE}" = "warm" ] && echo ngram_embedding.safetensors || true)
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-flashnext-${QSE_FN_BPW}
# ENG-241: three sequence slots over one engine, every window on the shared KV pool (2026-10-12, 3.05,
# fresh servers, greedy, raw): three requests arriving together took 27.18 s against 27.03 s one after
# the other (the same total tok/s), with first tokens at 2.2-6.1 s instead of up to ~20 s; each answer
# equal to its single-stream answer; one request alone 45.78 tok/s against 45.79 at --parallel 1; at
# 262,144 tokens with two 65,536-token side slots a 260,800-token prompt kept MemAvailable at 31.6 GiB
# or above (the floor 15). Limits, all serve.env's unless set here: side window QSE_SIDE_MAX_LEN 65,536 then,
# admission floor QSE_PARALLEL_FLOOR_GB 15, joint verify up to 32 rows, turn quantum 50 ms, batch
# timeout 2 ms, pool hard floor QSE_KV_HARD_FLOOR_GB 10, margin 256 rows; a side slot took 0.22 GiB
# allocated (0.40 GiB of MemAvailable) at load. SRV-707: 8 lanes, each the whole MAX_LEN on the pool (measured
# with 3).
QSE_PARALLEL=8
QSE_KV_POOL=on
# 0.8.2: Laya beside Flash-Next, as on the 27B box. It loads after the engine through the
# residency planner (claim 3.0 GiB, the 15 GiB floor, the 4 GiB margin and the engine's growth to
# its peak; on 3.05 with three slots 36.8 GiB stays after all of it); a box without the
# checkpoints under QWEN38_DECIDER_DIR, or without the room, serves without it and journals why.
# What it is for: the memory features ask the decider stages only, never the served model: the
# remember/forget/recall intent on a new user message (server/conductor/memory.py `_intent`, about
# 20 ms), the background writer's gate (memwriter.py `gate`) and the J1 test judge in shadow;
# without a decider they answer nothing and memory does not work. The router's class question does
# not use it: the router document's decider stage is off on both models since 2026-10-02 (Qwen
# 0.949 against Laya 0.782 on 216 labelled requests)
QWEN38_DECIDER_MODELS=laya-english,laya-multilingual,laya-typed-decisions
