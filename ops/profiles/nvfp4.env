# Weight profile nvfp4: the published NVFP4 set (the 0.4.8 release's weights), NVFP4 drafters ft-b8-v2 /
# ft-b16 from the deploy tree, the FP8 head, no draft head, the 0.4.8 sampled path (nucleus off).
# Sourced last by ops/serve.env (set -a) when ops/active-profile says nvfp4; switch with ops/use-profile.sh.
QSE_WEIGHTS=nvfp4
QSE_WEIGHTS_HF=0xBakeer/TandemLLM-Qwen3.8-27B-NVFP4
QSE_WEIGHTS_DIR=${HOME}/nvfp4-bf16
QSE_WEIGHTS_FILES="mlp.safetensors gdn.safetensors attn.safetensors head-fp8.safetensors"
QSE_WEIGHTS_GB=15
NV=${QSE_WEIGHTS_DIR}/mlp.safetensors,${QSE_WEIGHTS_DIR}/gdn.safetensors,${QSE_WEIGHTS_DIR}/attn.safetensors
HEAD=${QSE_WEIGHTS_DIR}/head-fp8.safetensors
CKPT8=${REPO}/train/ft-b8-v2
CKPT16=${REPO}/train/ft-b16
unset QWEN38_EXL3 QWEN38_DRAFT_EXL3 QWEN38_DRAFT_HEAD_EXL3
QWEN38_SAMPLE_NUCLEUS=0
# the disk tier's fingerprint is per build and weights: its own directory, so a switch never sweeps another's
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-nvfp4
