# Weight profile lfm25-bf16: LFM2.5-24B-A2B as Liquid published it, BF16 (~47.9 GB at revision 1769516a of
# the public HF repo), the engine's quality reference. Switch with ops/use-profile.sh lfm25-bf16.
QSE_LFM_VARIANT=bf16
QSE_WEIGHTS_HF=LiquidAI/LFM2.5-24B-A2B
QSE_WEIGHTS_REVISION=1769516ac588c4c558089c94f27d96b0dc67b183
QSE_WEIGHTS_GB=47.9
# MemAvailable (GiB) a start needs: the weights (44.65), the engine and its graphs, the allocator, the
# prefill workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=68
# SRV-335: the engine's limits. Ceiling: the weights (44.65) + the runtime (an estimate of 4 until measured)
# + the KV at 131,072 tokens (2.5); peak: the ceiling + the prefill workspace (an estimate of 3)
MEM_CEILING_GIB=52
MEM_PEAK_GIB=55
. "${REPO}/ops/profiles/_lfm25.env"
