# Shared by every ornith-<variant> profile (sourced from it after QSE_ORN_VARIANT, the weights' repo and size and the
# memory need are set): Ornith-1.5-122B (the Qwen3.5 MoE trunk, engine/models/qwen3_5_moe) from one of our EXL3 packs.
# The pack carries its MTP layer and its vision tower; a profile that drafts with DFlash2 names the drafter in QSE_ASSETS.
# QSE_ENGINE_FLAGS replaces the 27B's model and drafter flags in ops/start.sh; the rest of serve.env is shared.
QSE_WEIGHTS=ornith-1.5-122b-${QSE_ORN_VARIANT}
QSE_WEIGHTS_DIR=${HOME}/models/ornith-1.5-122b-${QSE_ORN_VARIANT}
QSE_WEIGHTS_FILES=
QSE_ASSETS=${QSE_ASSETS:-}
unset QWEN38_EXL3 QWEN38_DRAFT_EXL3 QWEN38_DRAFT_HEAD_EXL3
QWEN38_SAMPLE_NUCLEUS=1
# the draft head (QSE_ORN_HEAD): mtp, the pack's MTP layer as a chain of 3; dflash2, the DFlash2 block drafter of
# QSE_ORN_DFLASH2 over the trunk's taps. With the lookup (the request's text, CORPUS and the suffix store), one tree
# cut by StairCut
QSE_ENGINE_FLAGS="--model ${QSE_WEIGHTS_DIR} --drafter ${QSE_ORN_DRAFTER:-mtp} --depth 3 --draft-head ${QSE_ORN_HEAD:-mtp}"
QWEN38_Q35M_LOOKUP=1
# the pack's own vision tower (6-bit EXL3 projections) on the EXL3 kernels, images at three-axis rotary positions
VISION=on
# the model's window (max_position_embeddings): its KV is 24 KiB a token (12 attention layers, 2 KV heads of 256)
# plus 2 KiB for the MTP layer, 6.5 GiB at 262,144 tokens
MAX_LEN=262144
# one sequence slot (the joint verify of several slots is not built for this trunk yet)
QSE_PARALLEL=1
QSE_KV_POOL=off
# the checkpoint's generation_config.json: temperature 0.6, top_k 20, top_p 0.95
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
# #96: the answer limit when a request sends no max_tokens: the checkpoint's model card names 131,072 new tokens, and an
# answer at effort xhigh can pass serve.env's 32,768 (models/ornith-1.5-122b/card.json max_output holds the same number)
DEFAULT_MAX_TOKENS=131072
# the lookup's suffix store of this model's tokenizer
QWEN38_SUFFIX_STORE=${HOME}/.qwen38-spark-engine/suffix-ornith
QSE_PAGE_CACHE_DROP=${QSE_WEIGHTS_DIR}
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-ornith-${QSE_ORN_VARIANT}
SESSION_SPILL=on
QWEN38_DECIDER_MODELS=laya-english,laya-multilingual,laya-typed-decisions
