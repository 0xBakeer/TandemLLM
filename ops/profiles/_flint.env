# Shared by every flint-<variant> profile (sourced from it after QSE_FLINT_VARIANT, the weights' repo and size and the
# memory need are set): Recursive's Flint (engine/models/flint, ENG-E16) from one of our EXL3 packs. Nothing else is
# fetched: no drafter or draft head (the checkpoint has no draft layer), no vision tower (the model reads text).
# QSE_ENGINE_FLAGS replaces the 27B's model and drafter flags in ops/start.sh; the rest of serve.env is shared.
QSE_WEIGHTS=flint-${QSE_FLINT_VARIANT}
QSE_WEIGHTS_DIR=${HOME}/models/flint-${QSE_FLINT_VARIANT}
QSE_WEIGHTS_FILES=
QSE_ASSETS=
unset QWEN38_EXL3 QWEN38_DRAFT_EXL3 QWEN38_DRAFT_HEAD_EXL3
QWEN38_SAMPLE_NUCLEUS=1
# the lookup (the request's text, CORPUS and the suffix store) cut by StairCut; after a round cut to the anchor alone,
# 1, 2, 4, 8 rounds take the plain step without a draft
QSE_ENGINE_FLAGS="--model ${QSE_WEIGHTS_DIR} --drafter mtp"
QWEN38_FLINT_LOOKUP=1
QWEN38_FLINT_ANCHOR_BACKOFF=8
QWEN38_FLINT_LOOK_BACKOFF=8
VISION=off
# the model's window (max_position_embeddings): the 14 full-attention layers keep 28,672 bytes a token (7.0 GiB at
# 262,144 tokens), the 35 sliding layers a ring of 640 rows each (44.8 MiB in all)
MAX_LEN=262144
QSE_PARALLEL=1
QSE_KV_POOL=off
# the checkpoint's generation_config.json: temperature 1.0, top_p 0.95, top_k 20
TEMPERATURE=1.0
TOP_K=20
TOP_P=0.95
# the lookup's suffix store of this model's tokenizer
QWEN38_SUFFIX_STORE=${HOME}/.qwen38-spark-engine/suffix-flint
QSE_PAGE_CACHE_DROP=${QSE_WEIGHTS_DIR}
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-flint-${QSE_FLINT_VARIANT}
SESSION_SPILL=on
