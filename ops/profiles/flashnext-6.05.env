# Weight profile flashnext-6.05: Qwen3.8-Flash-Next in turboderp's EXL3 6.05 bpw pack (branch 6.05bpw_h6_ng6 of the
# public HF repo, ~137.7 GB with its n-gram table), its own MTP draft layer, the table cold. It fits no window on the Spark (the setup guide refuses it).
# Switch with ops/use-profile.sh flashnext-6.05.
QSE_FN_BPW=6.05
QSE_WEIGHTS_REVISION=6.05bpw_h6_ng6
QSE_WEIGHTS_GB=137.7
QSE_FN_TABLE=cold
# MemAvailable (GiB) a start needs: the weights on the device, the engine, the allocator, the prefill
# workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=114
# SRV-335: the engine's limits. Ceiling: the weights (91.85) + the runtime (4.15, measured on 3.05) +
# slot 0's KV at 262,144 tokens (7.58) + the caches at their caps (6) = 109.58; peak: this ceiling +
# the prefill workspace at 262,144 (2.75 + 18,432 bytes a token = 7.25). The table is not in them: it is
# page cache (warm) or host memory (cold), and every floor check counts the warm one.
MEM_CEILING_GIB=110
MEM_PEAK_GIB=118
. "${REPO}/ops/profiles/_flashnext.env"
