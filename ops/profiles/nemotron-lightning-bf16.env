# Weight profile nemotron-lightning-bf16: NVIDIA Nemotron 3.5 Lightning 30B-A3B as NVIDIA published it, BF16
# (65.8 GB with the MTP head at revision a9904d24 of the public HF repo), the NemotronH test model: the same block
# types as Bolt (Mamba2, NoPE attention, MoE, MTP). Switch with ops/use-profile.sh nemotron-lightning-bf16.
QSE_NH_MODEL=nemotron-3.5-lightning-30b-a3b
QSE_NH_VARIANT=lightning-bf16
QSE_WEIGHTS_HF=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
QSE_WEIGHTS_REVISION=a9904d24bcc1d289a1950fa9d2b978c47cf903b9
QSE_WEIGHTS_GB=65.8
# the model's whole context (max_position_embeddings): its KV is 6,144 bytes a token (6 attention layers, 2 KV
# heads of 128), 1.5 GiB at 262,144
MAX_LEN=262144
# MemAvailable (GiB) a start needs: the weights (59.04 allocated without the MTP head), the engine and its graphs,
# the allocator, the prefill workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=82
# the engine's limits. Ceiling: the weights (59.04) + the runtime (an estimate of 4 until measured) + the KV at
# 262,144 tokens (1.5); peak: the ceiling + the prefill workspace (an estimate of 3)
MEM_CEILING_GIB=65
MEM_PEAK_GIB=68
. "${REPO}/ops/profiles/_nemotron.env"
