# Weight profile flashnext-5.05: Qwen3.8-Flash-Next in turboderp's EXL3 5.05 bpw pack (branch 5.05bpw_h6_ng6 of the
# public HF repo, ~121.9 GB with its n-gram table), its own MTP draft layer, the table cold. The table is read past the page cache.
# Switch with ops/use-profile.sh flashnext-5.05.
QSE_FN_BPW=5.05
QSE_WEIGHTS_REVISION=5.05bpw_h6_ng6
QSE_WEIGHTS_GB=121.9
QSE_FN_TABLE=cold
# MemAvailable (GiB) a start needs: the weights on the device, the engine, the allocator, the prefill
# workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=100
# SRV-335: the engine's limits. Ceiling: the weights (77.14) + the runtime (4.15, measured on 3.05) +
# slot 0's KV at 262,144 tokens (7.58) + the caches at their caps (6) = 94.87; peak: this ceiling + the
# prefill workspace (10.75 GiB: it stops growing at about 140k tokens; 10.47 measured on 3.05 at
# 261,549 tokens, SPD-99). The table is not in them: it is page cache (warm) or host memory (cold),
# and every floor check counts the warm one.
MEM_CEILING_GIB=95
MEM_PEAK_GIB=106
. "${REPO}/ops/profiles/_flashnext.env"
