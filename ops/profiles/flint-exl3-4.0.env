# Weight profile flint-exl3-4.0: Recursive's Flint in our EXL3 pack at 4.0 bpw: every projection at 4 bits, head 5
# (exllamav3 1.6.2 + our Flint architecture, mul1 codebook; the routed experts' up projections stored divided by 128;
# 20.6 GB), from RecursiveSI/flint at revision 2a247be0. Against BF16 (8 held-out rows x 1,024): KL 0.160, top-1
# 80.5 %, ppl 31.65 against 29.88. Measured on the Spark (2026-10-22, 512 greedy tokens, one request): plain decode
# 121.9-124.1 tok/s, with the lookup up to 410.7 tok/s on a copy ask, prefill 4,652 tok/s at 4,096 tokens, 19.25 GiB
# at load. The pack is not published yet (its repository is private and empty): the weights directory is filled by hand. Switch with ops/use-profile.sh
# flint-exl3-4.0.
QSE_FLINT_VARIANT=exl3-4.0
QSE_WEIGHTS_HF=0xBakeer/TandemLLM-Flint-EXL3-4.0
QSE_WEIGHTS_GB=20.6
QSE_MEM_NEED_GIB=50
MEM_CEILING_GIB=32
MEM_PEAK_GIB=36
. "${REPO}/ops/profiles/_flint.env"
