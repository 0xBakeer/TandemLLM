# Weight profile flashnext-3.05: Qwen3.8-Flash-Next in turboderp's EXL3 3.05 bpw pack (branch 3.05bpw_h5_ng5 of the
# public HF repo, ~85.1 GB with its n-gram table), its own MTP draft layer, the table warm. The recommended pack.
# Switch with ops/use-profile.sh flashnext-3.05.
QSE_FN_BPW=3.05
QSE_WEIGHTS_REVISION=3.05bpw_h5_ng5
QSE_WEIGHTS_GB=85.1
QSE_FN_TABLE=warm
# MemAvailable (GiB) a start needs: the weights on the device, the engine, the allocator, the prefill
# workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=70
# SRV-335: the engine's limits. Ceiling: the weights (47.63) + the runtime (4.15, measured on 3.05) +
# slot 0's KV at 262,144 tokens (7.58) + the caches at their caps (6) = 65.36; peak: this ceiling +
# the prefill workspace at 262,144 (2.75 + 18,432 bytes a token = 7.25). The table is not in them: it is
# page cache (warm) or host memory (cold), and every floor check counts the warm one.
MEM_CEILING_GIB=66
MEM_PEAK_GIB=74
. "${REPO}/ops/profiles/_flashnext.env"
