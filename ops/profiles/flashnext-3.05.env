# Weight profile flashnext-3.05: Qwen3.8-Flash-Next in turboderp's EXL3 3.05 bpw pack (branch
# 3.05bpw_h5_ng5 of the public HF repo, ~85.1 GB with its n-gram table), its own MTP draft layer, the
# table cold (SPD-99: warm, the whole table resident breaks the 15 GiB floor at long windows). The
# recommended pack.
# Switch with ops/use-profile.sh flashnext-3.05.
QSE_FN_BPW=3.05
QSE_WEIGHTS_REVISION=3.05bpw_h5_ng5
QSE_WEIGHTS_GB=85.1
QSE_FN_TABLE=cold
# MemAvailable (GiB) a start needs: the weights on the device, the engine, the allocator, the prefill
# workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=70
# SRV-335: the engine's limits. Ceiling: the weights (47.63) + the runtime (4.15, measured on 3.05) +
# slot 0's KV at 262,144 tokens (7.58) + the caches at their caps (6) + the vision tower (0.29, VIS-97) =
# 65.65; peak: this ceiling + the prefill workspace (10.75 GiB: it stops growing at about 140k tokens;
# 10.47 measured on 3.05 at 261,549 tokens, SPD-99). The table is not in them: it is page cache (warm)
# or host memory (cold), and every floor check counts the warm one.
MEM_CEILING_GIB=66
MEM_PEAK_GIB=77
# SPD-249: the drafts' corrector of this pack (QWEN38_FN_MTP_CORRECTOR, _flashnext.env), 34.9 MB: ops/use-profile.sh
# fetches the file from this repository at this commit to the path the engine reads and checks its sha256; a download
# that fails leaves the coupled drafts plain, with the same tokens
QSE_CORRECTOR_HF=0xBakeer/TandemLLM-Qwen3.8-Flash-Next-EXL3-3.05-corrector
QSE_CORRECTOR_REVISION=9b95c171e309ca73d2f1073b934f2d246c99e1e7
QSE_CORRECTOR_SHA256=fe903accaf2dc18510fa4cee58701237c17dfd579d80a26c267fe0545c2c318b
QSE_CORRECTOR_PATH=${REPO}/ops/correctors/qwen3.8-flash-next/flashnext-3.05.corrector.safetensors
. "${REPO}/ops/profiles/_flashnext.env"
