# Weight profile flashnext-2.05: Qwen3.8-Flash-Next in turboderp's EXL3 2.05 bpw pack (branch 2.05bpw_h4_ng4 of the
# public HF repo, ~61.5 GB with its n-gram table), its own MTP draft layer, the table warm. The smallest pack.
# Switch with ops/use-profile.sh flashnext-2.05.
QSE_FN_BPW=2.05
QSE_WEIGHTS_REVISION=2.05bpw_h4_ng4
QSE_WEIGHTS_GB=61.5
QSE_FN_TABLE=warm
# MemAvailable (GiB) a start needs: the weights on the device, the engine, the allocator, the prefill
# workspace and the 15 GiB floor
QSE_MEM_NEED_GIB=55
# SRV-335: the engine's limits. Ceiling: the weights (32.83) + the runtime (4.15, measured on 3.05) +
# slot 0's KV at 262,144 tokens (7.58) + the caches at their caps (6) = 50.56; peak: this ceiling + the
# prefill workspace (10.75 GiB: it stops growing at about 140k tokens; 10.47 measured on 3.05 at
# 261,549 tokens, SPD-99). The table is not in them: it is page cache (warm) or host memory (cold),
# and every floor check counts the warm one.
MEM_CEILING_GIB=51
MEM_PEAK_GIB=62
. "${REPO}/ops/profiles/_flashnext.env"
