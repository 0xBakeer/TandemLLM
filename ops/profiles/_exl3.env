# Shared by every exl3-<bpw> profile (sourced from it after QSE_EXL3_BPW is set): the EXL3 target at that
# size (ENG-E6), both drafters in EXL3 K3 and the K4 draft head (ENG-215; size-independent), the nucleus
# sampler (931436b). NV/HEAD keep serve.env's values: the loader replaces what EXL3 quantises and reads
# them not at all. CKPT8/CKPT16 are the drafters' BF16 checkpoints under the repository's train/ (OPS-95:
# not serve.env's, which an install.sh box points into the HF cache or leaves empty): each arm loads its
# K3 file by its folder's name (QWEN38_DRAFT_EXL3/<ft-b8-v2|ft-b16>.safetensors) over the rest of it.
# Every file here is public and ops/use-profile.sh fetches what is missing (models/qwen3.8-27b/model.yaml).
QSE_WEIGHTS=exl3-${QSE_EXL3_BPW}
QSE_WEIGHTS_HF=0xBakeer/TandemLLM-Qwen3.8-27B-EXL3-${QSE_EXL3_BPW}
QSE_WEIGHTS_DIR=${HOME}/exl3-quants/${QSE_EXL3_BPW}
QSE_WEIGHTS_FILES=
QWEN38_EXL3=${QSE_WEIGHTS_DIR}
QWEN38_DRAFT_EXL3=${HOME}/.qwen38-spark-engine/weights/exl3-drafters-k3
QWEN38_DRAFT_HEAD_EXL3=${HOME}/.qwen38-spark-engine/weights/exl3-draft-head-k4
CKPT8=${REPO}/train/ft-b8-v2
CKPT16=${REPO}/train/ft-b16
# OPS-133: the base the EXL3 load reads besides the pack (models/qwen3.8-27b/model.yaml base-plain):
# the full FP8 snapshot when the box has it, else the plain tensors (3.54 GB of 30.41). OPS-143: where
# QWEN38_MODEL points (install.sh: its HF cache's snapshots folder), else the HF cache; a folder without
# a snapshot there is no base
_base_fp8=${QWEN38_MODEL:-${HF_HUB_CACHE:-${HF_HOME:-${HOME}/.cache/huggingface}/hub}/models--Qwen--Qwen3.8-27B-FP8/snapshots}
if [ ! -f "${_base_fp8}/config.json" ] && ! compgen -G "${_base_fp8}/*/config.json" >/dev/null; then
    QWEN38_MODEL=${HOME}/.qwen38-spark-engine/weights/base-plain
fi
unset _base_fp8
QWEN38_SAMPLE_NUCLEUS=1
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-exl3-${QSE_EXL3_BPW}
