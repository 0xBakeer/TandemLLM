# Shared by every lfm25-<variant> profile (sourced from it after QSE_LFM_VARIANT, the weights' repo and
# size and the memory need are set): LiquidAI's LFM2.5-24B-A2B (engine/models/lfm2_moe, ENG-E10) from its
# BF16 checkpoint or one of our EXL3 packs. Nothing else is fetched: no drafter, draft head or base
# snapshot (QSE_ASSETS empty), no vision tower (the model reads text). QSE_ENGINE_FLAGS replaces the 27B's
# model and drafter flags in ops/start.sh; the rest of serve.env (port, ledger, conductor, limits) is shared.
QSE_WEIGHTS=lfm25-${QSE_LFM_VARIANT}
QSE_WEIGHTS_DIR=${HOME}/models/lfm2.5-24b-a2b-${QSE_LFM_VARIANT}
QSE_WEIGHTS_FILES=
QSE_ASSETS=
unset QWEN38_EXL3 QWEN38_DRAFT_EXL3 QWEN38_DRAFT_HEAD_EXL3
QSE_ENGINE_FLAGS="--model ${QSE_WEIGHTS_DIR} --drafter none"
VISION=off
# the model's whole context (max_position_embeddings): its KV is 20,480 bytes a token, 2.5 GiB at 131,072
MAX_LEN=131072
# one sequence slot until the side slots are checked on this model (SPD-107)
QSE_PARALLEL=1
QSE_KV_POOL=off
# Liquid's recommended sampling (the checkpoint's generation_config.json), the server's defaults when a
# request names none: temperature 0.1, top_k 50, repetition penalty 1.05
TEMPERATURE=0.1
TOP_K=50
REP_PENALTY=1.05
# the lookup's suffix store of this tokenizer (the Qwen models' store holds other token ids, and the
# server refuses it by fingerprint)
QWEN38_SUFFIX_STORE=${HOME}/.qwen38-spark-engine/suffix-lfm25
QSE_PAGE_CACHE_DROP=${QSE_WEIGHTS_DIR}
QSE_DISK_CACHE=${HOME}/.qwen38-spark-engine/cache/disk-lfm25-${QSE_LFM_VARIANT}
