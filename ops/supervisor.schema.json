{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TandemLLM session monitor policy",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "bumped by every change, recorded with every decision"
    },
    "caps": {
      "type": "object",
      "properties": {
        "acts_per_request": {
          "type": "integer",
          "minimum": 0
        },
        "acts_per_session_hour": {
          "type": "integer",
          "minimum": 0
        },
        "same_action_in_a_row": {
          "type": "boolean",
          "description": "false: the same hidden action (kind and text) twice in a row on one turn is refused and ends in GIVE_UP"
        }
      },
      "required": [
        "acts_per_request",
        "acts_per_session_hour",
        "same_action_in_a_row"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "lineage_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "prompt tokens hashed into the session key when the client sends no conversation id"
        },
        "join_window_s": {
          "type": "number",
          "minimum": 0
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "lineage_tokens",
        "join_window_s",
        "max_sessions"
      ],
      "additionalProperties": false
    },
    "texts": {
      "type": "object",
      "properties": {
        "give_up": {
          "type": "string"
        }
      },
      "required": [
        "give_up"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "templates": {
      "type": "object",
      "properties": {
        "hidden_turn": {
          "type": "string",
          "description": "CONTINUE_HIDDEN after an empty answer: {text} is the nudge"
        },
        "tail_note": {
          "type": "string",
          "description": "PROMPT_TAIL_NOTE, appended to the last message: {text} is the note"
        },
        "think_open": {
          "type": "string",
          "description": "the generation prompt's tail with thinking on"
        },
        "think_off": {
          "type": "string",
          "description": "the same tail with thinking off"
        },
        "think_close": {
          "type": "string",
          "description": "the reasoning block's closer; what a hidden close lets the client see starts here"
        },
        "turn_start": {
          "type": "string",
          "description": "the token that opens a chat turn"
        },
        "turn_end": {
          "type": "string",
          "description": "the token that ends a chat turn"
        },
        "regen_turn": {
          "type": "string",
          "description": "REGENERATE_CALL after the answer's calls failed a check: {text} is the reminder, in the shape of a tool result"
        }
      },
      "required": [
        "hidden_turn",
        "tail_note",
        "think_open",
        "think_off",
        "think_close",
        "turn_start",
        "turn_end",
        "regen_turn"
      ],
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "tool_passes": {
          "type": "boolean",
          "description": "one journal row for every answer whose calls passed every check (a finding is always journaled; passes are counted either way)"
        }
      },
      "required": [
        "tool_passes"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "description": "SP4: S2: after a compaction the first steps read none of the state files -> the re-read note.",
            "properties": {
              "rule": {
                "const": "context_health"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "requires": {
                "type": "string",
                "description": "a pattern the system prompt must match, else the task stays silent (a project without state files); empty: always"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "the state files: a read of one of them (a call of a read tool whose arguments name it) is a re-read"
              },
              "read_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "the tools whose calls count as a read"
              },
              "skill_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "the tools that load a skill: a call counts as a re-read"
              },
              "steps": {
                "type": "integer",
                "minimum": 1,
                "description": "tool-call steps after the compaction that may pass without a re-read"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "the note"
              }
            },
            "required": [
              "rule",
              "mode",
              "files",
              "read_tools",
              "skill_tools",
              "steps",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP2: E1: a request that offered tools ends with no tool call and no text -> continue hidden.",
            "properties": {
              "rule": {
                "const": "empty_turn"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "close": {
                "type": "string",
                "minLength": 1,
                "description": "case A, the end token inside the reasoning: the hidden close"
              },
              "nudges": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "description": "case B, an empty answer after the reasoning: the hidden user turn's text, the n-th for the n-th act (the last one repeats)"
              },
              "tries": {
                "type": "integer",
                "minimum": 1,
                "description": "acts before GIVE_UP"
              }
            },
            "required": [
              "rule",
              "mode",
              "close",
              "nudges",
              "tries"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP4: S1: the same checker gate fails `fails` times without getting better -> end the stage.",
            "properties": {
              "rule": {
                "const": "gate_stagnation"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "requires": {
                "type": "string",
                "description": "a pattern the system prompt must match, else the task stays silent (a project without state files); empty: always"
              },
              "fails": {
                "type": "integer",
                "minimum": 1,
                "description": "failed runs in a row of one gate before the note"
              },
              "min_improvement": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "the share of the distance to the limit a reading must win to count as better"
              },
              "checkers": {
                "type": "array",
                "minItems": 1,
                "description": "the checkers whose RESULT lines count: a name and its header line (the first group is what it checked, so one gate on two targets is two gates)",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "header": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "header"
                  ],
                  "additionalProperties": false
                }
              },
              "gate": {
                "type": "string",
                "minLength": 1,
                "description": "a failing reason's gate label, its first group (\"(a) ...\" -> a); a reason without one is gated by its metric name"
              },
              "reading": {
                "type": "string",
                "minLength": 1,
                "description": "a reason's number, comparison and limit, three groups (\"12.3 > 1.0\")"
              },
              "stage": {
                "type": "object",
                "description": "where the stage comes from: the `pattern`'s first group in a read or a write of one of `files`; once per gate and stage",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "files",
                  "pattern"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "the note: {gate}, {checker}, {values} (the gate's readings, oldest first), {fails}"
              }
            },
            "required": [
              "rule",
              "mode",
              "fails",
              "min_improvement",
              "checkers",
              "gate",
              "reading",
              "stage",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP3: C4: a call that does not parse is repaired or written again; arguments that break the",
            "properties": {
              "rule": {
                "const": "malformed_call"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "texts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "description": "the reminder after a block that does not parse; {error} is the parser's reason"
              },
              "regenerations": {
                "type": "integer",
                "minimum": 0,
                "description": "regenerations a request may spend on unreadable calls; then the block goes out as content, as without the checks"
              },
              "repair": {
                "type": "boolean",
                "description": "try the deterministic fixes first (JSON with trailing commas or Python literals, an unquoted name, a missing </parameter>)"
              },
              "schema": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ],
                "description": "the arguments against the tool's JSON schema (required keys, types): at most this mode"
              },
              "schema_text": {
                "type": "string",
                "minLength": 1,
                "description": "the reminder for a schema problem: {name}, {problem}"
              },
              "cut": {
                "enum": [
                  "content",
                  "give_up"
                ],
                "description": "a call the token limit cut: content (as without the checks) or GIVE_UP (nothing of half a call goes out); a call the client's own stop string cut is always content"
              }
            },
            "required": [
              "rule",
              "mode",
              "texts",
              "regenerations",
              "repair",
              "schema",
              "schema_text",
              "cut"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP3: C2: AGENTS.md rules that text alone can decide: a numbered copy of a file the session",
            "properties": {
              "rule": {
                "const": "project_rules"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "requires": {
                "type": "string",
                "description": "a regex the system prompt must match for the rules to apply (the AGENTS.md text opencode sends); empty: always"
              },
              "path_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "argument keys that hold a file path"
              },
              "write_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "tools that create or overwrite a file"
              },
              "content_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "argument keys that hold a written file's text"
              },
              "numbered_copy": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "suffix": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a regex for what a numbered copy adds to a known file's stem"
                  }
                },
                "required": [
                  "enabled",
                  "suffix"
                ],
                "additionalProperties": false,
                "description": "a new file named like a file the session already used, plus a number"
              },
              "path_prefixes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "paths under these break the rule (/tmp/)"
              },
              "allow_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": [
                  "/tmp/opencode"
                ],
                "description": "paths no C2 rule applies to: a path covers everything under it, an entry with * ? [ is a glob (* crosses /), ~ is home, a relative entry is under the project root. Left out: /tmp/opencode, opencode's own scratch"
              },
              "max_lines": {
                "type": "integer",
                "minimum": 1,
                "description": "a written file longer than this breaks the rule"
              },
              "root": {
                "type": "string",
                "minLength": 1,
                "description": "as C1's: the project root from the system prompt"
              },
              "home": {
                "type": "string",
                "minLength": 1,
                "description": "as C1's"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "the reminder when a rule acts: {rule}, {path}, {detail}"
              }
            },
            "required": [
              "rule",
              "mode",
              "requires",
              "path_keys",
              "write_tools",
              "content_keys",
              "numbered_copy",
              "path_prefixes",
              "max_lines",
              "root",
              "home",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP1: D2: close the reasoning at min(cap, max_tokens - reserve), so an answer has room.",
            "properties": {
              "rule": {
                "const": "reasoning_backstop"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "close": {
                "type": "string",
                "minLength": 1,
                "description": "hidden close phrase; it must contain the reasoning closer (templates.think_close), and only what follows it is streamed"
              },
              "cap": {
                "type": "integer",
                "minimum": 1,
                "description": "the most reasoning tokens a request may write"
              },
              "reserve": {
                "type": "integer",
                "minimum": 1,
                "description": "tokens of max_tokens kept for the answer"
              }
            },
            "required": [
              "rule",
              "mode",
              "close",
              "cap",
              "reserve"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP1: D1: the reasoning is going in circles (a ThinkBudget arm fired) -> close it.",
            "properties": {
              "rule": {
                "const": "reasoning_loop"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "close": {
                "type": "string",
                "minLength": 1,
                "description": "hidden close phrase; it must contain the reasoning closer (templates.think_close), and only what follows it is streamed"
              },
              "arms": {
                "type": "object",
                "description": "the reasoning-loop detector's arms; an arm left out does not run",
                "properties": {
                  "loop": {
                    "type": "object",
                    "description": "a pattern of min_size..max_size tokens repeated back to back; it counts only when the repeats span min_span tokens or more (count = max(min_count, ceil(min_span / size)))",
                    "properties": {
                      "min_size": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max_size": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "min_count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "min_span": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "min_size",
                      "max_size",
                      "min_count",
                      "min_span"
                    ],
                    "additionalProperties": false
                  },
                  "repeat": {
                    "type": "object",
                    "description": "history arm: the share of the last `window` tokens' `gram`-grams that already occurred earlier in the block, checked every `every` tokens after `min_tokens`; fires at `act` or above on `in_a_row` checks in a row, reports `grey` to `act` as an observation",
                    "properties": {
                      "gram": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "window": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "every": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "min_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "act": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "grey": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "in_a_row": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "gram",
                      "window",
                      "every",
                      "min_tokens",
                      "act",
                      "grey",
                      "in_a_row"
                    ],
                    "additionalProperties": false
                  },
                  "novelty": {
                    "type": "object",
                    "description": "the share of new `gram`-grams in the last `window` tokens against the window before; fires below `below` after `min_tokens`",
                    "properties": {
                      "window": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "gram": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "min_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "below": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "window",
                      "gram",
                      "min_tokens",
                      "below"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "rule",
              "mode",
              "close",
              "arms"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP3: C3: the same call a third time after two identical results -> write something else.",
            "properties": {
              "rule": {
                "const": "repeated_call"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "repeats": {
                "type": "integer",
                "minimum": 2,
                "description": "the call that would be the n-th in a row with the same name and arguments, after n-1 identical results"
              },
              "texts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "description": "the reminder: {name}, {count} (the earlier runs), {first_line} (of their result)"
              },
              "first_line_chars": {
                "type": "integer",
                "minimum": 8
              }
            },
            "required": [
              "rule",
              "mode",
              "repeats",
              "texts",
              "first_line_chars"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP3: C1: the risk floors (arbiter's guard_policy as a list): rm -rf outside the project root,",
            "properties": {
              "rule": {
                "const": "risk_floor"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "floors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "pattern",
                        "rm_outside_root",
                        "write_outside_root"
                      ],
                      "description": "pattern: the regex matches an argument; rm_outside_root: an `rm` the regex finds removes a path outside the project root; write_outside_root: a path argument lies outside the root"
                    },
                    "tools": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "tool names it applies to; empty: every tool"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "argument keys it reads; empty: every string argument"
                    },
                    "pattern": {
                      "type": "string",
                      "description": "a regular expression; for rm_outside_root its group `targets` holds the paths"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind",
                    "tools",
                    "args",
                    "pattern"
                  ],
                  "additionalProperties": false
                }
              },
              "root": {
                "type": "string",
                "minLength": 1,
                "description": "a regex whose first group is the project root, read from the system prompt (opencode states its working directory)"
              },
              "home": {
                "type": "string",
                "minLength": 1,
                "description": "a regex whose first group is the home directory, read from the root, for paths that start with ~"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "the reminder when a floor acts: {label}, {match}"
              }
            },
            "required": [
              "rule",
              "mode",
              "floors",
              "root",
              "home",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "SP4: S4: no file changed, no commit and no better checker number for `minutes` -> a note.",
            "properties": {
              "rule": {
                "const": "stall_watchdog"
              },
              "mode": {
                "enum": [
                  "off",
                  "shadow",
                  "act"
                ]
              },
              "requires": {
                "type": "string",
                "description": "a pattern the system prompt must match, else the task stays silent (a project without state files); empty: always"
              },
              "minutes": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "minutes without progress before the note; also the idle time after a turn before the client counts as gone"
              },
              "change": {
                "type": "object",
                "properties": {
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "ok": {
                    "type": "string",
                    "minLength": 1,
                    "description": "the result's pattern when it worked"
                  },
                  "args": {
                    "type": "string",
                    "minLength": 1,
                    "description": "the call's arguments must match"
                  }
                },
                "required": [
                  "tools",
                  "ok"
                ],
                "additionalProperties": false,
                "description": "a file changed: a call of these tools whose result matches `ok`"
              },
              "commit": {
                "type": "object",
                "properties": {
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "ok": {
                    "type": "string",
                    "minLength": 1,
                    "description": "the result's pattern when it worked"
                  },
                  "args": {
                    "type": "string",
                    "minLength": 1,
                    "description": "the call's arguments must match"
                  }
                },
                "required": [
                  "tools",
                  "ok"
                ],
                "additionalProperties": false,
                "description": "a commit: a call of these tools whose arguments match `args` and whose result matches `ok`"
              },
              "checkers": {
                "type": "array",
                "minItems": 1,
                "description": "the checkers whose RESULT lines count: a name and its header line (the first group is what it checked, so one gate on two targets is two gates)",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "header": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "header"
                  ],
                  "additionalProperties": false
                }
              },
              "gate": {
                "type": "string",
                "minLength": 1,
                "description": "a failing reason's gate label, its first group (\"(a) ...\" -> a); a reason without one is gated by its metric name"
              },
              "reading": {
                "type": "string",
                "minLength": 1,
                "description": "a reason's number, comparison and limit, three groups (\"12.3 > 1.0\")"
              },
              "min_improvement": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "the share of the distance to the limit a reading must win to count as better"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "the note: {minutes}"
              },
              "notify": {
                "type": "object",
                "description": "one push through the ntfy stack when the client has gone; never in shadow, off unless enabled (the overnight profile turns it on)",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "description": "the ntfy topic URL"
                  },
                  "token_file": {
                    "type": "string",
                    "description": "a file on the box holding the publish token (never in the policy itself)"
                  },
                  "ca_file": {
                    "type": "string",
                    "description": "the CA bundle for the URL, empty: the system's"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "description": "{session}, {client}, {profile}, {minutes}"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "description": "{session}, {client}, {profile}, {minutes}, {requests}"
                  },
                  "priority": {
                    "enum": [
                      "min",
                      "low",
                      "default",
                      "high",
                      "urgent"
                    ]
                  },
                  "tags": {
                    "type": "string"
                  },
                  "timeout_s": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "enabled",
                  "url",
                  "token_file",
                  "ca_file",
                  "title",
                  "message",
                  "priority",
                  "tags",
                  "timeout_s"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "rule",
              "mode",
              "minutes",
              "change",
              "commit",
              "checkers",
              "gate",
              "reading",
              "min_improvement",
              "text",
              "notify"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "caps",
    "session",
    "texts",
    "templates",
    "journal",
    "tasks"
  ],
  "additionalProperties": false
}
