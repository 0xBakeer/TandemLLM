# The serving configuration, in one file, because it is the thing that has to be reproducible.
#
# Everything here is a decision with a measurement behind it (docs/measurement.md); the ones
# that are not obvious:
#
#   LEN_FIXED=0    with LEN_LATCH=1: the drafter policy decides the block width once a REQUEST
#   LEN_LATCH=1    rather than once a block. Per-block routing loses to a fixed sixteen once
#                  arms start switching: switching arms costs acceptance whether or not the
#                  switch was a good idea. Four wide blocks, up to four narrow probes, one
#                  decision, then no more switching.
#   MAX_LEN        the KV buffer is allocated for all of it at load (tools/mem_audit.py):
#                  64 KiB a token of engine KV + 20 KiB a token for each of the two drafter
#                  arms = 106.5 KiB a token, 27.9 GB of KV at 256k, and 53.45 GB for the whole
#                  served stack in a fresh process.
#   CACHE_GB       the state cache's budget, after the KV has been paid for.
#   FUSE_PROJ=0    the fused projection groups are lossless and worth ~1 %. They are OFF in
#                  the release candidate because the candidate is a stability release; set
#                  to 1 to measure them.
HOME_DIR=${HOME}
REPO=${HOME}/qwen38-spark-engine
PY=${HOME}/recipes/ling3-flash-dgx-spark/.venv/bin/python
PYTHONPATH=${HOME}/pylibs

HOST=0.0.0.0
PORT=8000
SERVED_MODEL=qwen38-spark-engine

# The published NVFP4 set (huggingface.co/0xBakeer/TandemLLM-Qwen3.8-27B-NVFP4), the one the StairCut paper measured.
NV=${HOME}/nvfp4-bf16/mlp.safetensors,${HOME}/nvfp4-bf16/gdn.safetensors,${HOME}/nvfp4-bf16/attn.safetensors
HEAD=${HOME}/nvfp4-bf16/head-fp8.safetensors
CKPT8=${REPO}/train/ft-b8-v2
CKPT16=${REPO}/train/ft-b16
CORPUS=${REPO}/corpus

MAX_LEN=262144
# Whole-file asks (level rows included) can exceed 16,384 tokens even inside a code block;
# the cap -- not the model -- was deciding the deliverable.
DEFAULT_MAX_TOKENS=32768
# Anti-repetition. All empty/absent = the server defaults, which are the identities:
# penalties off, no pattern stop, byte-identical output. Per-request body params
# (`repetition_penalty`, `presence_penalty`, `frequency_penalty`) override the server defaults --
# Open WebUI model rows that already send `presence_penalty` are honoured the moment the engine
# restarts, so check the roster's values before flipping anything here.
#REP_PENALTY=1.05
#PRESENCE_PENALTY=1.0
#FREQUENCY_PENALTY=0.0
# A repeat-pattern guard (period:min_repeats:window). A tight floor (e.g. 64:1:8) can cut a
# legitimate generated file mid-line: a long run of identical tokens can be real data (a
# repeated separator or level row) rather than a degenerate loop, and no periodic-run detector
# can tell the two apart below "longer than a plausible row". OFF on the served engine: the
# thinking phase already has its own stall detectors, and an answer loop is bounded by
# max_tokens, whose cut is visible in the response. Set to e.g. 256:32:8 to re-arm.
PATTERN_STOP=
REASONING_FORMAT=tags
REASONING_EFFORT=medium
LEN_FIXED=0
LEN_LATCH=1
BUDGET=16
# 8, not 24: at the 262k window the engine holds ~53 GB, the page cache holds ~40 GB of
# weights, and a single boundary snapshot at 30-40k tokens is 2-4 GB that is CLONED BEFORE
# evictions run -- 53 + 24 + 40 peaks at the board's edge, and a long-prompt prefill can wedge
# the box (MemAvailable -> 0, GPU driver lock). 8 GB keeps the transient well clear; StateStore
# also refuses any single snapshot over a quarter of the budget.
CACHE_GB=8
# Once the service answers, ops/start.sh drops the page cache of the weight files
# (tools/drop_page_cache.py, fadvise DONTNEED, no root): ~52 GB the engine never reads again,
# counted as available but not given back in time -- a large prefill can otherwise take
# MemFree close to 0 and trigger a GPU out-of-memory error. 0 keeps the cache (a restart then
# loads from RAM, not the NVMe).
DROP_PAGE_CACHE=1
# 3600: a whole-file rewrite needs 20-30k tokens at 15-20 tok/s, and a 900 s wall clock cuts
# them mid-file. A runaway is still capped; the queue is single-sequence anyway.
REQUEST_TIMEOUT=3600
MAX_QUEUE=8
# 240: while a long agent run holds the engine, a second request can wait rather than be
# refused outright. 240 s stays under Open WebUI's ~300 s OpenAI client timeout, so a request
# that can be served waits instead of erroring. Beyond that the answer is concurrency, not
# patience.
QUEUE_TIMEOUT=240
FUSE_PROJ=0

# Set explicitly so the serving configuration is readable in one place even where it agrees with
# the code default. Both were tried; run-to-run noise on this board (~10 % on the mean between
# two runs of the same engine) makes them hard to resolve against each other, so they are at the
# values the release candidate was soaked on, and they go to the `speed` branch to be measured
# against several rows each.
# `nodes`: the served tree budgets never leave room for a branch until the narrow arm's budget
# grows past its block; `nodes` then accepts 8-17 % more than `paths` (tools/tree_sweep.py).
QWEN38_DF2_TREE_MODE=nodes
QWEN38_TREE_ALIAS_STATE=0

# Release the arm that loses the latch: no tap, no sync, and nothing of it in the state
# snapshot. Lossless (tools/verify_spec.py --drop-idle reports `identical` on every workload),
# and on the paired five-workload bench it is ahead of the router on 15 of 15 comparisons --
# five workloads times three repeats -- for a median of +3.2 % and a mean of +4.0 %, with
# accepted-per-block equal or better everywhere. The saving is largest exactly where the
# engine is fastest, because what stops is a `sync` over the ACCEPTED rows: +1.5 % on prose at
# 2.7 accepted a block, +7.1 % on edit at 12.6.
DROP_IDLE=1
# How sharply the DRAFTER's proposal distribution is tempered relative to the request.
# Sampled-with-drafter measured ~30 tok/s at 1.0 (the draft's spread over wrong tokens) and
# 35-43 at 0.3-0.5 on the same prompt; 0.3 is the served default and the request body may
# override with draft_temperature.
QWEN38_DRAFT_TEMP=0.3
# A sampled request verifies the greedy request's TREE, the target's token drawn at each node
# and the walk following the child that carries it (`det`), instead of the q-aware chain.
# Exact by construction: the tree never depends on the draws it is walked with. Sampled
# five-workload bench (temperature 0.7, draft 0.3, 3 rounds alternated): tokens a round
# 4.07/4.15/4.08 -> 5.21/5.33/5.27 (+28 %), tok/s 44.6/45.0/44.7 -> 53.1/54.1/54.1 (+19..+21 %),
# every workload resolved better. On the board the answers match the target sampled alone
# (tools/sampled_dist.py: 2,400 + 1,920 answers, min p 0.023 / 0.056 against a Bonferroni
# 0.0011 / 0.0033, the 0.5-temperature control seen at 1e-7 / 2e-11). Greedy is not touched
# (the flag is read only for a sampled request): identity and lossless gate PASS, greedy
# answers identical, nothing resolved worse. `mixed` (the sampled spine) is exact too and
# slower than det on every workload. Unset = the q-aware chain.
SAMPLED_TREE=det
# rc3: the fused GDN prefill kernel. Gate: tools/prefill_quality.py, 8k/16k, PASS (NLL delta
# <= 0.005 nats; divergence no worse than the control). TTFT 760 -> 691 ms on the row; decode
# neutral (fixed-policy A/B overlaps).
QWEN38_FUSED_GDNPREFILL=1
# rc4 (speed2), three flags adopted together on rows taken with the persistent suffix store
# OFF (every earlier row otherwise read its own answers back from it). Against two store-off
# baselines, two candidate rows each: mean +5.8..+7.9 % RESOLVED, TTFT 690-709 -> 427 ms
# RESOLVED, nothing resolved worse; clean-store view mean +4.8 % RESOLVED. Lossless gate PASS
# with all three.
#   QWEN38_DECODE_ATTN   decode/verify attention reading the KV once (tools/attn_kernels.py):
#                        decode at a 32k prompt 7.43 -> 16.46 tok/s; quality gate = the control.
#   QWEN38_DRAFT_NVFP4   the block drafter's projections in NVFP4: draft call ~24 -> ~14 ms.
#   QWEN38_NVFP4_PREFILL_V2  the v2 W4A16 tile for 33..1023-row prefills: TTFT -38 %; quality PASS.
QWEN38_DECODE_ATTN=1
QWEN38_DRAFT_NVFP4=1
QWEN38_NVFP4_PREFILL_V2=1
# phase4 (not deployed): the v2 tile for the 1,024-row chunks too. The prefix cache forwards
# every prompt in 1,024-row chunks and the old bound (1024, exclusive) sent each full chunk to
# the unpack path, where gate/up is 24 % slower than v2 and down level (tools/prefill_crossover.py;
# unpack wins from 2,048 / 1,536 rows). Served-path TTFT 8k 12.1 -> 10.6 s, 16k 24.4 -> 21.5,
# 32k 30.5 -> 26.7 (-12 %); prefill_quality at 2k/8k/16k, chunk 1,024: NLL -0.0009 / +0.0002 /
# +0.0014 (per prompt <= +0.0043), divergence not worse than the control -- PASS; quality-gated,
# not bit-gated (a prefill has no ulp identity).
QWEN38_NVFP4_PREFILL_V2_UNTIL=1025
# rc4 (kernels), seven flags adopted together on the new-text row. Against rc4's speed2
# defaults (cand-nostore / -r2 / cand-clean), the bundle (kb-nostore, kb-nostore-r2, kb-clean):
# mean +21.9..+25.0 % RESOLVED, p50 +23.9..+29.1 % RESOLVED, p90, max, TTFT and wall resolved
# better in all six comparisons, nothing resolved worse; 33.9-34.7 mean / 31.2-32.1 p50.
# Lossless gate (verify_spec, the served tree router and the chain router, five workloads):
# PASS. In-engine block 123 -> ~99 ms.
#   QWEN38_NVFP4_SKINNY     W4A16 for 1..32 rows in CUDA, a packed byte straight into a tensor-core
#                           operand (tools/nvfp4_skinny.py); gate/up 193 -> 220 GB/s in the engine
#   QWEN38_SKINNY_TILES     its per-shape tile table, the one the rows ran (nt2:wk16:pf2)
#   QWEN38_FUSED_COMMIT     the block's commit for all 48 GDN layers in one kernel, no state copies
#   QWEN38_FUSED_GDNVERIFY  a verify block's GDN mixer in four kernels a layer
#   QWEN38_DRAFT_FC_NVFP4   the drafter's context projection in NVFP4 (drafter only)
#   QWEN38_FUSED_ADDNORM    residual add fused into the next RMS norm (bit-identical)
#   QWEN38_TREE_HOST_DEPTH  a tree verify's depth from the host, not 48 device reads (bit-identical)
#   QWEN38_HOST_WALK        the drafter's greedy walk with one device read (same tokens)
QWEN38_NVFP4_SKINNY=1
QWEN38_SKINNY_TILES=${REPO}/ops/skinny-tiles.json
QWEN38_FUSED_COMMIT=1
QWEN38_FUSED_GDNVERIFY=1
QWEN38_DRAFT_FC_NVFP4=1
QWEN38_FUSED_ADDNORM=1
QWEN38_TREE_HOST_DEPTH=1
QWEN38_HOST_WALK=1
# phase1, adopted one item at a time on branch `phase1` on the rows' block time: each item's
# ms/blk resolved better against the adopted set before it in every pair (store off twice,
# clean once), tokens/block not resolved worse, nothing resolved worse (ops/gate.sh).
#   QWEN38_VERIFY_GRAPH     the verify from CUDA graphs; ms/blk 99.1/98.9/98.6 -> 95.8/95.8/95.5
#                           (-3.2..-3.4 %), tok/blk 3.33/3.30/3.26 (not resolved), mean +2.4..+3.4 %
QWEN38_VERIFY_GRAPH=1
#   QWEN38_COMMIT_IN_VERIFY the commit folded into the next verify's recurrence; ms/blk on top of
#                           the graph 95.8/95.8/95.5 -> 93.7/93.9/93.4 (-2.0..-2.2 %), tok/blk not
#                           moved; with the graph, mean +5.7..+6.7 % over rc4k, resolved in all pairs
QWEN38_COMMIT_IN_VERIFY=1
#   QWEN38_DRAFT_GRAPH      the draft call from a graph per context class (512/1,024/2,048); ms/blk
#                           on top of graph + fold 93.7/93.4 -> 92.7/92.7/92.6 (-0.9..-1.0 %), tok/blk
#                           not moved; the set's mean +6.6..+8.4 % over rc4k, resolved in all pairs
QWEN38_DRAFT_GRAPH=1
# phase2, adopted on branch `phase2` by the ratified per-item rule (ms/blk resolved better
# in every comparison, nothing resolved worse; a p90 regression the same configuration does not
# reproduce on a re-run is noise) -- ops/gate.sh.
#   QWEN38_GDNV_ONE_WARP    one warp a GDN verify recurrence program; ms/blk 92.7/92.7/92.6 ->
#                           91.5/91.5/91.4 (-1.2..-1.5 % against the deployed rows and the re-run),
#                           mean/p50/tok_blk unchanged; p90 resolved worse in 1 of 3 rows (one prompt's
#                           text, mix-0248, flips on a near-tie), not reproduced on the re-run
QWEN38_GDNV_ONE_WARP=1
#   QWEN38_TREE_NODES_NARROW  the narrow arm's tree at 16 nodes from its 7-slot lattice -- the
#                           same 16-row verify the served wide arm pays -- built node-wise (its
#                           QWEN38_DF2_TREE_MODE=nodes above), priced on the measured verify curve
#                           (QWEN38_TREE_MS, verify + commit at 8/16/24/32 rows).
#                           Gate eng107c against the set before it and the deployed rows: tok/blk
#                           3.30/3.26 -> 3.64/3.71/3.76 (+10..+15 %), ms/blk +0.4..+2.2 %, mean
#                           36.9/36.4 -> 39.9/40.3/40.4 (+8..+11 %), p50 +11..+21 %, nothing resolved
#                           worse (max 85.6-85.7, TTFT 420-424 ms). Lossless PASS.
QWEN38_TREE_NODES_NARROW=16
QWEN38_TREE_MS=8:77.9,16:78.9,24:87.0,32:97.0
#   QWEN38_TREE_NODES + QWEN38_TREE_WIDE_AFTER  the wide arm's tree at 24 nodes, but only once the
#                           request has committed 32 tokens (a short answer never pays the 24-row verify
#                           for branches it cannot use: the row's max is a 41-token answer), on the
#                           verify curve past 16 rows (QWEN38_VERIFY_ROWS=32 + the 17..32-row tile table
#                           that keeps each shape's K split). Gate eng107d against the deployed rows: mean
#                           36.7/36.3 -> 41.5/42.0/41.4 (+13..+14 %), p50 +17..+18 %, tok/blk 3.32/3.28
#                           -> 4.02/4.04/4.02 (+21..+23 %), ms/blk +4.7..+5.8 %, max and TTFT not
#                           resolved; against eng107c (narrow 16 only): mean +2.5..+5.1 %, tok/blk
#                           +7..+11 %, max -2.6..-3.2 % in the two store-off rows (the 41-token request's
#                           last block). Lossless PASS with 32-node trees.
QWEN38_VERIFY_ROWS=32
QWEN38_SKINNY_TILES_WIDE=${REPO}/ops/skinny-tiles-wide.json
QWEN38_TREE_NODES=24
QWEN38_TREE_WIDE_AFTER=32
#   QWEN38_DEEP + QWEN38_DEEP_AFTER  after two wide blocks in a row commit their whole width,
#                           the lookup drafter's exact continuation of the request's own text as one
#                           chain of up to 32 rows. A serving default: lossless (verify_spec at 256
#                           tokens, three deep blocks on edit: identical), row-neutral by construction
#                           (spd12 41.08/41.88/41.45 against eng107d 41.53/41.95/41.40, nothing
#                           resolved either way), edit +15 % on the five-workload bench (15.75
#                           accepted a block against 12.60).
QWEN38_DEEP=32
QWEN38_DEEP_AFTER=2
#   QWEN38_LEN_SWITCH + QWEN38_LEN_MODE=wide  the node count of every round calculated on the verify
#                  staircase: the wide drafter only, each candidate cut to the count that maximises its
#                  expected committed tokens per ms, the narrow drafter released at the first round.
#                  QWEN38_STAIR_TABLES prices the cut by context length (chain and tree apart);
#                  QWEN38_STAIR_RHO gives the lookup's continuation rate on 8-token matches;
#                  QWEN38_STAIR_SKIP prices the head-skip rule on the same staircase. The
#                  tables were measured on the NVFP4 set from the BF16 release.
QWEN38_LEN_SWITCH=1
QWEN38_LEN_MODE=wide
QWEN38_STAIR_TABLES=${REPO}/ops/stair-tables-nvfp4.json
QWEN38_STAIR_RHO=${REPO}/ops/lookup-rho.json
QWEN38_STAIR_SKIP=1
# phase5: the skinny kernel reads its e4m3 scales from a copy laid out in runs of 16 rows x one
# 128-wide K step (128 contiguous bytes), made on a weight's first skinny call. A permutation of the same bytes read in
# the same order: bit-identical (kernel battery, 162 outputs; identity against the release tree, every tensor).
# Alternated A/B, store off: ms/blk 94.88 -> 92.50 (-2.5 %), mean +2.9 %, both resolved, nothing resolved worse. The
# set (phase5 + this) against the release alternated in one hold: store off mean 42.38 -> 43.90 (+3.6 %), ms/blk
# 95.29 -> 92.74; clean 42.69 -> 43.91 (+2.8 %), ms/blk 94.66 -> 92.00; nothing resolved worse. Costs +1.45 GiB (the
# copies of the 400 target projections' scales).
QWEN38_SKINNY_SRUN=1
# phase6: the e4m3 head GEMM at BN 32, 4 warps, 6 stages (bit-identical to 64:4:3, +2 % GB/s)
# QWEN38_HEAD_GEMM=32:4:6  # OFF: OutOfResources (102400 > 101376 B smem) on a penalty request with an 11.7k prompt (head GEMM over many rows); default 64:4:3 until the config is sized per M

# The usage ledger -- one SQLite row per request (counts and times, no text), 400 days, backed
# up weekly beside it. ops/start.sh passes it to the :8000 service only; the server never takes
# it from the environment, so row3 / gate / soak servers do not write it.
QSE_USAGE_LEDGER=${HOME}/.qwen38-spark-engine/usage/ledger.sqlite3

# phase3, adopted on branch `phase3` by the per-item rule (ops/gate.sh --mode block) against
# the deployed Phase 2 rows (p2final).
#   QWEN38_GDNV_CONV_BLOCK / _WARPS  the GDN verify convolution at 32 channels a program on
#                           one warp (320 programs, not 40 walking the block's rows): bit-identical (flags on ==
#                           off on the real model), -0.7..-1.5 ms a 48-layer block on the bench; the rows' ms/blk
#                           98.26/98.37 -> 97.32/97.39 store off (resolved in all four pairs), clean 97.42 ->
#                           96.38 on the re-run pair (resolved; against p2final-clean's 96.98 not resolved), nothing
#                           resolved worse, lossless PASS.
QWEN38_GDNV_CONV_BLOCK=32
QWEN38_GDNV_CONV_WARPS=1
#   QWEN38_GDNV_WY (+ _WY_FUSED, the MAXT thresholds)  a verify block of up to 16 rows
#                           (the narrow arm's 16-node trees, the wide arm's first chains) takes the GDN recurrence
#                           in the WY form -- every row at once, (I + A) d = beta (v - exp(G) K S0) -- with the
#                           convolution and the gates inside its two kernels; longer blocks walk (the fused prep
#                           is pathological at a 32-row tile). Same mathematics in another order (per-row updates
#                           1e-7 of float64), lossless PASS; gate spd38 on top of step 1: ms/blk 97.32/97.32/96.38
#                           -> 95.94/96.54/95.69 (-1.4/-0.8/-0.7 %, resolved in all three), nothing resolved worse.
QWEN38_GDNV_WY=1
QWEN38_GDNV_WY_FUSED=1
QWEN38_GDNV_WY_MAXT=16
QWEN38_GDNV_WY_CHAIN_MAXT=16
QWEN38_GDNV_WY_FUSED_MAXT=16

# The live activity on /v1/dashboard/live. LIVE_ACTIVITY=off is the kill switch (the 1.0 view,
# new fields null); QSE_LIVE_HZ is its busy cadence (1, 2, 4; default 4).
LIVE_ACTIVITY=on

# The dashboard login. off (the default): /v1/dashboard/* answers anyone who reaches the port, and
# the page opens with no sign-in; what it shows is listed in docs/dashboard.md "Access". on: the
# admin token or a session, from secrets.env (ops/make-secrets.sh), and 404 without that file.
# /metrics, the full /health and the cache routes keep their own rules either way.
QSE_DASHBOARD_LOGIN=off
