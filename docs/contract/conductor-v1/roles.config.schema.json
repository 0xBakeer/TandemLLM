{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor roles document",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "endpoint": {
        "type": "string",
        "maxLength": 400
      },
      "model": {
        "type": "string",
        "maxLength": 200
      },
      "contract": {
        "enum": [
          "jev",
          "openai-chat",
          "rerank"
        ]
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120000
      },
      "memory_gb": {
        "type": "number",
        "minimum": 0,
        "maximum": 128
      },
      "mode": {
        "enum": [
          "off",
          "shadow",
          "on"
        ]
      }
    },
    "required": [
      "endpoint",
      "model",
      "contract",
      "timeout_ms",
      "memory_gb",
      "mode"
    ],
    "additionalProperties": false
  }
}
