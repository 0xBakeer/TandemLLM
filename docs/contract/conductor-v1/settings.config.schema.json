{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor settings document",
  "type": "object",
  "properties": {
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "journal": {
      "type": "object",
      "properties": {
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "digest": {
          "enum": [
            "tools",
            "all",
            "none"
          ]
        }
      },
      "required": [
        "retention_days",
        "digest"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "transcripts": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "tools",
                "all",
                "none"
              ]
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            },
            "clip_chars": {
              "type": "integer",
              "minimum": 200,
              "maximum": 100000
            },
            "loop_chars": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000
            }
          },
          "required": [
            "scope",
            "retention_days",
            "clip_chars",
            "loop_chars"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "default_profile",
    "journal"
  ],
  "additionalProperties": false
}
