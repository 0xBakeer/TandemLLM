{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor settings document",
  "type": "object",
  "properties": {
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "journal": {
      "type": "object",
      "properties": {
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "digest": {
          "enum": [
            "tools",
            "all",
            "none"
          ]
        }
      },
      "required": [
        "retention_days",
        "digest"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "transcripts": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "tools",
                "all",
                "none"
              ]
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            },
            "clip_chars": {
              "type": "integer",
              "minimum": 200,
              "maximum": 100000
            },
            "loop_chars": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000
            }
          },
          "required": [
            "scope",
            "retention_days",
            "clip_chars",
            "loop_chars"
          ],
          "additionalProperties": false
        },
        "disk_cache": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "on",
                "off"
              ]
            },
            "budget_gb": {
              "type": "number",
              "minimum": 1,
              "maximum": 4000
            },
            "ttl_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "admit_after": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "min_free_gb": {
              "type": "number",
              "minimum": 50,
              "maximum": 4000
            }
          },
          "required": [
            "mode",
            "budget_gb",
            "ttl_days",
            "admit_after",
            "min_free_gb"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "object",
          "properties": {
            "index_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8000
            },
            "body_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000
            },
            "pinned_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "bodies": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "min_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "min_words": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "dedupe_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "intent": {
              "enum": [
                "off",
                "shadow",
                "on"
              ]
            },
            "provisional": {
              "type": "boolean"
            },
            "digest_chars": {
              "type": "integer",
              "minimum": 200,
              "maximum": 20000
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "default_profile",
    "journal"
  ],
  "additionalProperties": false
}
