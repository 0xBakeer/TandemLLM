{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor stats",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "hours": {
      "type": "integer"
    },
    "decisions": {
      "type": "integer"
    },
    "acted": {
      "type": "integer"
    },
    "shadow": {
      "type": "integer"
    },
    "changed": {
      "type": "integer"
    },
    "injections": {
      "type": "integer"
    },
    "injected_tokens": {
      "type": "integer"
    },
    "by_class": {
      "type": "object"
    },
    "by_source": {
      "type": "object"
    },
    "by_effort": {
      "type": "object"
    },
    "classifier": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "calls": {
            "type": "integer"
          },
          "p50_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "p95_ms": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "calls",
          "p50_ms",
          "p95_ms"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "object"
    },
    "fail_open_rate": {
      "type": [
        "number",
        "null"
      ]
    },
    "model_decided": {
      "type": "integer"
    },
    "labels": {
      "type": "object",
      "properties": {
        "right": {
          "type": "integer"
        },
        "wrong": {
          "type": "integer"
        }
      },
      "required": [
        "right",
        "wrong"
      ],
      "additionalProperties": false
    },
    "hourly": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "by_class": {
            "type": "object"
          },
          "acted": {
            "type": "integer"
          },
          "shadow": {
            "type": "integer"
          }
        },
        "required": [
          "start_ms",
          "total",
          "by_class",
          "acted",
          "shadow"
        ],
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "object"
    },
    "precision": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "enum": [
              "classify",
              "effort",
              "packages",
              "rules"
            ]
          },
          "decisions": {
            "type": "integer"
          },
          "labelled": {
            "type": "integer"
          },
          "agree": {
            "type": "integer"
          },
          "precision": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "profile",
          "decision",
          "decisions",
          "labelled",
          "agree",
          "precision"
        ],
        "additionalProperties": false
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "string"
          },
          "decisions": {
            "type": "integer"
          },
          "labelled": {
            "type": "integer"
          },
          "agree": {
            "type": "integer"
          }
        },
        "required": [
          "class_id",
          "decisions",
          "labelled",
          "agree"
        ],
        "additionalProperties": false
      }
    },
    "monitor": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "contract_version",
    "hours",
    "decisions",
    "acted",
    "shadow",
    "changed",
    "injections",
    "injected_tokens",
    "by_class",
    "by_source",
    "by_effort",
    "classifier",
    "failures",
    "fail_open_rate",
    "model_decided",
    "labels",
    "hourly",
    "roles",
    "precision",
    "classes",
    "monitor"
  ],
  "additionalProperties": false
}
