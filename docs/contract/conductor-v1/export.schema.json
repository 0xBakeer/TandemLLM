{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor export",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "session": {
      "type": "string"
    },
    "turns": {
      "type": "integer"
    },
    "interventions": {
      "type": "integer"
    },
    "injections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "contract_version",
    "session",
    "turns",
    "interventions",
    "injections"
  ],
  "additionalProperties": false
}
