{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://qwen38-spark-engine.local/contract/dashboard-v1/logs.schema.json",
 "title": "GET /v1/dashboard/logs?follow=0 (the follow=1 stream sends one LogLine per `event: log`)",
 "type": "object",
 "properties": {
  "contract_version": {
   "const": "1.0"
  },
  "lines": {
   "type": "array",
   "items": {
    "$ref": "defs.schema.json#/$defs/LogLine"
   }
  },
  "last_seq": {
   "type": "integer"
  }
 },
 "required": [
  "contract_version",
  "lines",
  "last_seq"
 ],
 "additionalProperties": false
}
