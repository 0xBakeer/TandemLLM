{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/dashboard-v1/system.schema.json",
  "title": "GET /v1/dashboard/system",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "code_sha256": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "uptime_s": {
          "type": "number",
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string",
          "description": "the name the server answers with: TandemLLM with the conductor configured, else --served-model"
        },
        "base_model": {
          "type": [
            "string",
            "null"
          ],
          "description": "the base engine's own name (--served-model), a hidden alias of TandemLLM when the conductor is configured"
        },
        "max_len": {
          "type": "integer",
          "minimum": 0
        },
        "drafter": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree": {
          "type": "boolean"
        },
        "reasoning_format": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "busy",
            "draining",
            "offline"
          ]
        }
      },
      "required": [
        "version",
        "git_sha",
        "code_sha256",
        "started_at",
        "uptime_s",
        "pid",
        "model",
        "max_len",
        "drafter",
        "tree",
        "reasoning_format",
        "reasoning_effort",
        "status"
      ],
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "properties": {
        "args": {
          "type": "object"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "args",
        "env"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "gpu_allocated_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gpu_reserved_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gpu_max_allocated_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "the allocator's peak since the process started (OPS-47 resets the counter before each prefill to measure it; this keeps the maximum across the resets)"
        },
        "unified_total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unified_available_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "process_rss_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "split": {
          "description": "OPS-41: where the engine's resident set goes, in bytes: the allocator's totals, the named parts read off the objects that hold them (weights, kv_pool, gdn_state, drafter_kv, vision, state_store, resident_prefix), what the allocator holds beyond them (other) and keeps without a tensor (reserve), and the load stages' deltas; null when it could not be read",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "allocated": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reserved": {
              "type": [
                "integer",
                "null"
              ]
            },
            "parts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "other": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reserve": {
              "type": [
                "integer",
                "null"
              ]
            },
            "mem_available": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max_len": {
              "type": [
                "integer",
                "null"
              ]
            },
            "drafter_caches": {
              "type": "integer",
              "minimum": 0
            },
            "load": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stage": {
                    "type": "string"
                  },
                  "allocated": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reserved": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "mem_available_drop": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "s": {
                    "type": "number"
                  }
                },
                "required": [
                  "stage",
                  "allocated",
                  "reserved",
                  "mem_available_drop",
                  "s"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "allocated",
            "reserved",
            "parts",
            "other",
            "reserve",
            "mem_available",
            "max_len",
            "drafter_caches"
          ],
          "additionalProperties": false
        },
        "limits": {
          "description": "OPS-47: the engine's memory limits (server/memlimits.py view()): one row per serve.env key with its value, where it comes from (serve.env, or the residency document's engine section edited in the dashboard), whether a change applies at the next request or needs a restart (MAX_LEN is locked at 262,144), and what it holds now against its cap (bytes for GiB and MiB keys); the memory policy's report (engine/cache.py Budget: ceiling, peak, slack, the shed counts and log); the last session switch and its re-read cost; the parked session. Null when it could not be read",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "version": {
              "type": [
                "integer",
                "null"
              ]
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "unit": {
                    "enum": [
                      "GiB",
                      "MiB",
                      "tokens",
                      "on/off"
                    ]
                  },
                  "what": {
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "flag": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "source": {
                    "enum": [
                      "serve.env",
                      "dashboard"
                    ]
                  },
                  "applies": {
                    "enum": [
                      "next request",
                      "restart",
                      "locked"
                    ]
                  },
                  "locked": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "running": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "pending_restart": {
                    "type": "boolean"
                  },
                  "used": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cap": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "key",
                  "unit",
                  "what",
                  "value",
                  "flag",
                  "source",
                  "applies",
                  "locked",
                  "running",
                  "pending_restart",
                  "used",
                  "cap"
                ],
                "additionalProperties": false
              }
            },
            "budget": {
              "type": [
                "object",
                "null"
              ],
              "description": "engine/cache.py Budget.report(): the limits in bytes, the allocator's numbers less the decision models, the workspace estimate, counts, the shed log",
              "properties": {
                "ceiling": {
                  "type": "integer"
                },
                "peak": {
                  "type": "integer"
                },
                "slack": {
                  "type": "integer"
                },
                "allocated": {
                  "type": "integer"
                },
                "reserved": {
                  "type": "integer"
                },
                "reserve": {
                  "type": "integer"
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "ts": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "kind",
                      "ts"
                    ]
                  }
                },
                "shed": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "refused": {
                  "type": "integer"
                },
                "prefill_peak": {
                  "type": "integer"
                }
              },
              "required": [
                "ceiling",
                "peak",
                "slack",
                "allocated",
                "reserved",
                "reserve",
                "events",
                "shed",
                "refused",
                "prefill_peak"
              ]
            },
            "workspace_at_max_len": {
              "type": [
                "integer",
                "null"
              ]
            },
            "switch": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "ts": {
                  "type": "number"
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tokens": {
                  "type": "integer"
                },
                "reused": {
                  "type": "integer"
                },
                "reread": {
                  "type": "integer"
                },
                "via": {
                  "type": "string"
                },
                "ms": {
                  "type": "number"
                }
              },
              "required": [
                "ts",
                "from",
                "to",
                "tokens",
                "reused",
                "reread",
                "via",
                "ms"
              ],
              "additionalProperties": false
            },
            "switches": {
              "type": "integer",
              "minimum": 0
            },
            "park": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rows": {
                  "type": "integer"
                },
                "base": {
                  "type": "integer"
                },
                "bytes": {
                  "type": "integer"
                }
              },
              "required": [
                "owner",
                "rows",
                "base",
                "bytes"
              ],
              "additionalProperties": false
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "version",
            "rows",
            "budget",
            "workspace_at_max_len",
            "switch",
            "switches",
            "park",
            "owner"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "gpu_allocated_bytes",
        "gpu_reserved_bytes",
        "gpu_max_allocated_bytes",
        "unified_total_bytes",
        "unified_available_bytes",
        "process_rss_bytes"
      ],
      "additionalProperties": false
    },
    "gpu": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sm_clock_mhz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "utilization": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampled_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "temperature_c",
        "power_w",
        "sm_clock_mhz",
        "utilization",
        "source",
        "sampled_at"
      ],
      "additionalProperties": false
    },
    "caches": {
      "type": "object"
    },
    "queue": {
      "type": "object",
      "properties": {
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "waiting": {
          "type": "integer",
          "minimum": 0
        },
        "max_queue": {
          "type": "integer",
          "minimum": 0
        },
        "queue_timeout_s": {
          "type": "number",
          "minimum": 0
        },
        "request_timeout_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "running",
        "waiting",
        "max_queue",
        "queue_timeout_s",
        "request_timeout_s"
      ],
      "additionalProperties": false
    },
    "inflight": {
      "type": "object",
      "properties": {
        "served": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "timeouts": {
          "type": "integer",
          "minimum": 0
        },
        "abandoned": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "served",
        "refused",
        "errors",
        "timeouts",
        "abandoned"
      ],
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "oldest": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "rows",
        "bytes",
        "oldest",
        "queue",
        "dropped"
      ],
      "additionalProperties": false
    },
    "disk": {
      "type": "object",
      "properties": {
        "state_dir_free_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "state_dir_free_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "generated_at",
    "engine",
    "flags",
    "memory",
    "gpu",
    "caches",
    "queue",
    "inflight",
    "ledger",
    "disk"
  ],
  "additionalProperties": false
}
